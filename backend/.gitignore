# Backend (.gitignore) — Python / FastAPI

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
ENV.bak/
venv.bak/

# Environment variables (never commit secrets)
.env
.env.*
!.env.example

# Packaging / distribution
build/
dist/
*.egg-info/
.eggs/
*.egg

# Test / type-check / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Uvicorn / app logs
*.log
logs/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
